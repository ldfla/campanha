# === Banco de Dados ===
DB_USERNAME=fundraiser
DB_PASSWORD=fundraiser_dev
DB_ROOT_PASSWORD=root_dev
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fundraiser

# === Object Storage (opcional) ===
# `memory` (padrão) dispensa object storage no MVP local. Para MinIO, use
# `infrastructure/compose.minio.yaml` e defina APP_STORAGE_PROVIDER=minio.
APP_STORAGE_PROVIDER=memory
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_ENDPOINT=http://localhost:9000

# === Mailpit (Email DEMO) ===
MAIL_HOST=localhost
MAIL_PORT=1025

# === Aplicação ===
APP_LIVE_OPERATIONS_ENABLED=false
# Base64 de 32 bytes; não preencher com chave real neste arquivo.
SURPRISE_ENCRYPTION_KEY=
APP_DEFAULT_CAMPAIGN_MODE=DEMO

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8080/api
